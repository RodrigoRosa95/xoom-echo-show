# ~/.env do notebook (painel e assistente). Copie para alexa/.env o que a skill usa. Nunca envie o arquivo real ao Git.

# Home Assistant
HA_TOKEN=

# Voz: transcrição e perguntas gerais
GROQ_API_KEY=

# Google Agenda: URL iCal secreta (mais de uma separadas por vírgula)
GOOGLE_AGENDA_ICS=

# Câmera IP (RTSP)
CAMERA_YOOSEE_SENHA=

# Jellyfin
JELLYFIN_API_KEY=
JELLYFLIX_JELLYFIN_URL=http://127.0.0.1:8096

# Skills da Alexa
ALEXA_SKILL_ID_JELLYFLIX=
ALEXA_SKILL_ID_TABLET=
JELLYFLIX_URL_PUBLICA=https://seu-dominio.exemplo/api/jellyflix
# Texto longo e aleatório: assina as URLs de áudio
JELLYFLIX_SEGREDO=
JELLYFLIX_PORTA=3011
JELLYFLIX_BIBLIOTECA_TOP=Top 50 Brasil
# Parte do nome do aparelho da TV no Jellyfin
JELLYFLIX_TV=Smart TV
# Usuários do Jellyfin da casa, separados por vírgula
JELLYFLIX_USUARIOS=

# Opcionais da skill
SONARR_URL=http://127.0.0.1:8989
SONARR_API_KEY=
RADARR_URL=http://127.0.0.1:7878
RADARR_API_KEY=
JELLYSEERR_URL=http://127.0.0.1:5055
JELLYSEERR_API_KEY=
JELLYFLIX_QBIT_URL=http://127.0.0.1:8080
JELLYFLIX_PAUSA=

# Vigia: comando que recebe o texto do alerta
VIGIA_AVISO_CMD=
